{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ImageStorage": {
    "Provider": "Local"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Security": {
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutMinutes": 15
    },
    "RateLimit": {
      "Authentication": {
        "PermitLimit": 5,
        "WindowMinutes": 1
      }
    }
  },
  "AllowedHosts": "*"
}
